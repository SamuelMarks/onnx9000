#!/bin/bash
set -e

if [ ! -d "node_modules" ]; then
  echo "⚠️  node_modules is missing."
  echo "Please run 'pnpm install' before committing, or use 'git commit --no-verify' to skip hooks."
  exit 1
fi

echo "Running Pre-commit Linters & Formatters..."
uv run ruff format --config pyproject.toml
if command -v fd >/dev/null 2>&1 && command -v clang-format >/dev/null 2>&1; then
  fd -eh -ec -x clang-format --style=LLVM -i
else
  echo "⚠️  fd or clang-format not found; skipping C/C++ formatting check."
fi
pnpm exec biome check --write .

echo "Running Static Analysis..."
pnpm lint
uv run ruff check .
uv run python scripts/check_docstrings.py
uv run mypy .

echo "Building TypeScript packages..."
pnpm exec turbo run build

echo "Running Tests & Generating Coverage..."
# Export PYTHONPATH for all python source directories
export PYTHONPATH=$(find packages/python -maxdepth 1 -mindepth 1 -type d | sed 's/$/\/src/' | tr '
' ':'):apps/cli/src

# 1. TypeScript tests
pnpm exec vitest run --coverage

# 2. Python Tests (Generating coverage.json)
rm -f .coverage coverage.json

uv run pytest -c pyproject.toml --cov --cov-branch --cov-fail-under=100 -q

# Generate json report and enforce 100% coverage threshold
uv run coverage json
uv run coverage report --fail-under=100

echo "Updating Badges in README.md..."
uv run python scripts/update_badges.py

echo "Pre-commit hook finished successfully!"
